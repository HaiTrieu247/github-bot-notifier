# ─── Database (self-hosted postgres container — REQUIRED) ─────────────────────
# The bot's DATABASE_URL is built from these in docker-compose.yml.
# Use hex/alphanumeric only for the password (it is embedded in a URL),
# e.g. `openssl rand -hex 24`. The deploy workflow generates one if missing.
# Changing it after the volume is created has no effect on the DB itself.
POSTGRES_PASSWORD=
POSTGRES_USER=github_bot
POSTGRES_DB=github_bot

# One-time migration source (scripts/migrate_from_neon.sh). Falls back to the
# legacy DATABASE_URL. Remove both once the migration is done.
# NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
PORT=8000

# ─── Security ─────────────────────────────────────────────────────────────────
# Mật khẩu JWT (Dùng để tạo phiên đăng nhập, hãy thay đổi khi lên production)
ADMIN_JWT_SECRET="supersecret-jwt-key-replace-in-production"
# Mã bí mật Base32 cho Google Authenticator (16 hoặc 32 ký tự, gồm A-Z và 2-7)
# Nếu để trống, hệ thống sẽ tự sinh ra một mã mỗi khi khởi động (chỉ dùng tạm thời).
ADMIN_TOTP_SECRET=

# ─── Initial seed values (used only on first startup to populate DB config) ───
# After first run, manage all these via the Admin Dashboard at http://<host>/admin
# Changes here only take effect if the DB has no existing value for that key.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DEFAULT_CHANNEL_ID=
DISCORD_REPO_CHANNEL_MAP=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORIES=