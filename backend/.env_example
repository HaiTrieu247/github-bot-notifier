# ─── Database (cloud NeonDB — REQUIRED) ───────────────────────────────────────
# Format: postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
PORT=8000

# ─── Initial seed values (used only on first startup to populate DB config) ───
# After first run, manage all these via the Admin Dashboard at http://<host>/admin
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DEFAULT_CHANNEL_ID=
DISCORD_REPO_CHANNEL_MAP=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORIES=
