# ─── Database (REQUIRED when running the backend outside docker compose) ──────
# With docker compose this is ignored — the URL is built from POSTGRES_* in the root .env.
DATABASE_URL=postgresql+asyncpg://github_bot:password@localhost:5432/github_bot

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
PORT=8000

# ─── Initial seed values (used only on first startup to populate DB config) ───
# After first run, manage all these via the Admin Dashboard at http://<host>/admin
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DEFAULT_CHANNEL_ID=
DISCORD_REPO_CHANNEL_MAP=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORIES=
