# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Default channel for repos that don't have a specific channel configured
DISCORD_DEFAULT_CHANNEL_ID=

# Per-repo channel mapping: comma-separated "owner/repo:channel_id" pairs
# Example: Kens0107/homestay-backend:123456789,Kens0107/frontend:987654321
DISCORD_REPO_CHANNEL_MAP=

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=

# Comma-separated list of owner/repo to monitor
GITHUB_REPOSITORIES=Kens0107/homestay-backend,Kens0107/homestay-frontend

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=github_bot
POSTGRES_USER=github_bot
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://github_bot:password@postgres:5432/github_bot

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=staging
LOG_LEVEL=INFO
PORT=8000
